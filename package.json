{
  "name": "@chester-hill-solutions/terminal-aide",
  "version": "0.1.1",
  "description": "Plain English to Bash: preview the command, then confirm with y/[n]. Powered by North Mini Code through OpenRouter.",
  "author": {
    "name": "Chester Hill Solutions",
    "url": "https://github.com/chester-hill-solutions"
  },
  "homepage": "https://github.com/chester-hill-solutions/terminal-aide#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chester-hill-solutions/terminal-aide.git"
  },
  "bugs": {
    "url": "https://github.com/chester-hill-solutions/terminal-aide/issues"
  },
  "keywords": [
    "cli",
    "terminal",
    "bash",
    "shell",
    "ai",
    "natural-language",
    "command-line",
    "openrouter",
    "cohere",
    "north-mini-code",
    "developer-tools",
    "macos",
    "linux"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "type": "module",
  "bin": {
    "aide": "bin/aide.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/aide.js",
    "test": "node --test",
    "check": "npm run check:syntax && npm run check:quality",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:quality": "node scripts/check-quality.mjs",
    "quality:tighten": "ratchet-strap tighten --exec-eslint --eslint-config scripts/eslint.config.mjs --write",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-include=bin/** --test-coverage-lines=98 --test-coverage-branches=90 --test-coverage-functions=94",
    "eval:self-test": "node scripts/evaluate-model.mjs --self-test --output .local/model-reference-self-test.json",
    "eval:model": "node scripts/evaluate-model.mjs --delay-ms 4000",
    "pack:check": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run check && npm run test:coverage && npm run pack:check"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE",
    "docs/CHANGELOG.md"
  ],
  "license": "MIT",
  "dependencies": {
    "cli-spinners": "3.4.0"
  },
  "devDependencies": {
    "@chester-hill-solutions/ratchet-strap": "file:tools/vendor/chester-hill-solutions-ratchet-strap-0.4.0.tgz",
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0"
  }
}
