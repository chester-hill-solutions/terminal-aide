{
  "name": "@chester-hill-solutions/terminal-aide",
  "version": "0.1.1",
  "description": "Plain English to Bash: preview the command, then confirm with y/[n]. Powered by North Mini Code through OpenRouter.",
  "author": {
    "name": "Chester Hill Solutions",
    "url": "https://github.com/chester-hill-solutions"
  },
  "homepage": "https://github.com/chester-hill-solutions/terminal-aide#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chester-hill-solutions/terminal-aide.git"
  },
  "bugs": {
    "url": "https://github.com/chester-hill-solutions/terminal-aide/issues"
  },
  "keywords": [
    "cli",
    "terminal",
    "bash",
    "shell",
    "ai",
    "natural-language",
    "command-line",
    "openrouter",
    "cohere",
    "north-mini-code",
    "developer-tools",
    "macos",
    "linux"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "type": "module",
  "bin": {
    "aide": "bin/aide.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/aide.js",
    "test": "node --test",
    "check": "node scripts/check-syntax.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run check && npm test && npm run pack:check"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE",
    "docs/CHANGELOG.md"
  ],
  "license": "MIT",
  "dependencies": {
    "cli-spinners": "3.4.0"
  }
}
